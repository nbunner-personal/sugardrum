<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <script>
    // Apply a saved light/dark choice before the page renders (see js/scripts.js)
    try {
      var savedTheme = localStorage.getItem("theme");
      if (savedTheme === "light" || savedTheme === "dark") document.documentElement.dataset.theme = savedTheme;
    } catch (e) {}
  </script>
  {%- if page.url == "/404.html" %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  <title>{{ title | default: site.title }}</title>
  {%- if isPost %}
    {%- assign metaDescription = content | excerpt: excerpt | truncate: 160 %}
  {%- elsif title %}
    {%- assign metaDescription = site.description | append: " - " | append: title %}
  {%- else %}
    {%- assign metaDescription = site.description %}
  {%- endif %}
  <meta name="description" content="{{ metaDescription | escape }}">
  <link rel="canonical" href="{{ page.url | absoluteUrl: site.url }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ '/feed.xml' | absoluteUrl: site.url }}">

  {%- if title %}
  <meta property="og:title" content="{{ title | escape }}">
  {%- endif %}
  <meta property="og:description" content="{{ metaDescription | escape }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl: site.url }}">
  {%- if thumb %}
  <meta property="og:image" content="{{ site.mediaUrl }}{{ thumb }}">
  {%- else %}
  <meta property="og:image" content="{{ '/images/photos/sugardrum-silhouette.jpg' | absoluteUrl: site.url }}">
  <meta property="og:image:width" content="500">
  <meta property="og:image:height" content="375">
  {%- endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,700;1,400&amp;display=swap">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="/css/main.css?v={{ assetVersion }}">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  {%- assign iconSizes = "57,72,76,114,120,144,152,180" | split: "," %}
  {%- for size in iconSizes %}
  <link rel="apple-touch-icon" sizes="{{ size }}x{{ size }}" href="/img/mobile-icons/apple-touch-icon-{{ size }}x{{ size }}.png">
  {%- endfor %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  {% include "partials/header.html" %}

  <div id="content" class="content">
    {%- if topSectionText %}
    <section class="top-section clearfix">
      {% include topSectionText %}
    </section>
    {%- endif %}

    <div class="content-panel {% if fullWidth %}full-width{% else %}col-cont{% endif %}">
      {{ content }}
    </div>
  </div>

  {% include "partials/footer.html" %}

  <script type="module" src="/js/main.js?v={{ assetVersion }}"></script>
  <script data-host="https://microanalytics.io" data-dnt="false" src="https://microanalytics.io/js/script.js" id="ZwSg9rf6GA" async defer></script>
</body>
</html>
